                        "details": [
                            {
                                "id": "script0_5",
                                "name": "Intro Script 0.5",
                                "text": "The 3 of you walk across the courtyard of Gealian, you remember all of the memories you have had up until this point. Your first day in the fall you turned 16. All of your classes, field trips. The late nights studying. You try your best to recall all you have learned as you approach your final test. You find your adventure adviser, Myril. The woman who has been overseeing your training from the very beginning. \n\nMyril: this is your last test before becoming true adventures. This exercise was hand designed to test all of your skills. Best of luck. \n",
                                "type": "text",
                                "width": 400,
                                "height": 400
                            },
                            {
                                "id": "notes0_5",
                                "name": "Intro Notes 0.5",
                                "text": "These are the notes for the part.",
                                "type": "text",
                                "width": 400,
                                "height": 400
                            }
                        ]
